# ---------------------------------------------------------------------------
# SpendGuard API — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/spendguard
# Optional: override the DB used by the Jest suite (default: spendguard_test).
# Tests are ALWAYS forced to a test DB - MONGO_URI is ignored under NODE_ENV=test.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/spendguard_test

# JWT — use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS — comma separated list of allowed origins for the browser client
CLIENT_ORIGIN=http://localhost:5173

# Analytics tuning (all values are documented in the README)
MICRO_SPEND_THRESHOLD=200
MIN_DAYS_FOR_PATTERNS=14
MIN_DAYS_FOR_RECURRING=60
